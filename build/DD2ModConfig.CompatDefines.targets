<Project>
    <!--
        DD2ModConfig API compatibility defines.
        Generates STS2_AT_LEAST_<ver> symbols based on Sts2ApiCompat.
        Source code uses #if STS2_AT_LEAST_0_110_0 for version-conditional logic.
    -->

    <PropertyGroup>
		<_DD2ModConfigSupportedApiVersions>0.107.0;0.111.0</_DD2ModConfigSupportedApiVersions>
		<_DD2ModConfigSupportedApiList>|0.107.0|0.111.0|</_DD2ModConfigSupportedApiList>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.107.0'))">$(DefineConstants);STS2_AT_LEAST_0_107_0</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.108.0'))">$(DefineConstants);STS2_AT_LEAST_0_108_0</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.110.0'))">$(DefineConstants);STS2_AT_LEAST_0_110_0</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.111.0'))">$(DefineConstants);STS2_AT_LEAST_0_111_0</DefineConstants>
    </PropertyGroup>

    <Target Name="ValidateDD2ModConfigCompatTarget" BeforeTargets="CoreCompile">
        <Error
            Condition="'$(Sts2ApiCompat)' == '' or !$(_DD2ModConfigSupportedApiList.Contains('|$(Sts2ApiCompat)|'))"
            Text="Sts2ApiCompat='$(Sts2ApiCompat)' is not supported. Supported: $(_DD2ModConfigSupportedApiVersions)."/>
    </Target>
</Project>
